# Resend API Key for VIP Early Access Reservations
RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here

# Sender Email (Requires domain verification in resend.com/domains to email users)
# Once your domain (e.g. onehaat.com) is verified in Resend, set this to:
# RESEND_FROM_EMAIL="OneHaat <welcome@onehaat.com>"
RESEND_FROM_EMAIL="OneHaat <onboarding@resend.dev>"

# Notification Destination & Public Contact Email
CONTACT_EMAIL=access.onehaat@gmail.com
VITE_CONTACT_EMAIL=access.onehaat@gmail.com


